# Copy this file to .env and fill it in. Keep .env private.

# Miniflux
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=change-me-please
POSTGRES_PASSWORD=change-me-too

# Maniflux (the reader app)
# Miniflux: Settings > API Keys > Create
MINIFLUX_API_KEY=
# Absolute path to the vault's content folder on this Mac
VAULT_CONTENT_PATH=/Users/you/Documents/Obsidian Vault/content
# Time zone for note dates (date-added, published)
TZ=America/Los_Angeles
# OpenRouter: Maniflux writes each saved note's type and description
OPENROUTER_API_KEY=
# Optional, defaults to anthropic/claude-haiku-5.5
# OPENROUTER_MODEL=
# Optional, the model that writes digests; defaults to anthropic/claude-sonnet-5.5
# DIGEST_MODEL=

# What runs on this machine (see server/README.md):
#   personal server: COMPOSE_PROFILES=reader
#   Mac:             COMPOSE_PROFILES=ig2rss
COMPOSE_PROFILES=reader,ig2rss
# The addresses you open Miniflux and Maniflux at. On the server, the move script fills these in.
# MINIFLUX_BASE_URL=http://127.0.0.1:8080/
# MANIFLUX_PUBLIC_URL=http://127.0.0.1:8090
# Where Miniflux reaches ig2rss, shown in ig2rss as the feed address to add. With Miniflux on the
# server, set it on the Mac to the Mac's Tailscale address (`tailscale ip -4`), e.g. http://100.x.y.z:8091
# IG2RSS_FEED_BASE_URL=http://ig2rss:8091
