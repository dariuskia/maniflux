# Copy this file to .env and fill it in. Keep .env private.

# Miniflux
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=change-me-please
POSTGRES_PASSWORD=change-me-too

# Maniflux (the reader app)
# Miniflux: Settings > API Keys > Create
MINIFLUX_API_KEY=
# Absolute path to the vault's content folder on this Mac
VAULT_CONTENT_PATH=/Users/you/Documents/Obsidian Vault/content
# Time zone for note dates (date-added, published)
TZ=America/Los_Angeles
# OpenRouter: Maniflux writes each saved note's type and description
OPENROUTER_API_KEY=
# Optional, defaults to anthropic/claude-haiku-5.5
# OPENROUTER_MODEL=
